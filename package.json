{
  "name": "wildai-cli",
  "version": "1.2.0",
  "description": "Oficjalne, nowoczesne CLI dla platformy WildAI z obsługą tokenów i narzędzi deweloperskich",
  "main": "dist/index.js",
  "bin": {
    "wildai": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean --minify --out-dir dist",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wildai",
    "ai",
    "cli",
    "terminal",
    "assistant",
    "agent",
    "tokens",
    "llm"
  ],
  "author": "WildAI Team",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "axios": "^1.16.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^20.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0"
  }
}
